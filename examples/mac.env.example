# Copy to mac/.env, chmod 600. Use an SSH config alias.
LIVE_REPLAY_SERVER=replay-server
LIVE_REPLAY_REMOTE_SCRIPT=/srv/replay/replay.py
LIVE_REPLAY_FEISHU_CHAT=
# Comma-separated sender IDs as returned by lark-cli; names are not accepted.
LIVE_REPLAY_REVIEWERS=
LIVE_REPLAY_CONTEXT=歌回录播；按本场实际内容判断语言和演唱类型。
LIVE_REPLAY_WHISPER_MODEL=
# Optional absolute path to your private catalog; default uses empty example.
LIVE_REPLAY_CATALOG=
# Optional: one catalog per streamer, named <streamer>.md (same as the recording filename prefix).
# When set, it replaces LIVE_REPLAY_CATALOG; streamers without a file get the empty example.
LIVE_REPLAY_CATALOG_DIR=
LIVE_REPLAY_CODEX_SANDBOX=workspace-write
# Optional: inherit your configured model when empty.
LIVE_REPLAY_CODEX_MODEL=
